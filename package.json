{
  "name": "cloakify",
  "version": "1.0.0",
  "private": true,
  "description": "Cloakify — 100% client-side, zero-network browser PII detection and data sanitization tool",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
